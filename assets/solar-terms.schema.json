{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "24 Chinese solar terms apparent longitude calculation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.3.0"
    },
    "astronomy": {
      "type": "object",
      "required": [
        "library",
        "library_version",
        "requested_ephemeris",
        "effective_ephemeris",
        "license"
      ],
      "properties": {
        "requested_ephemeris": {
          "enum": [
            "moseph",
            "swieph"
          ]
        },
        "effective_ephemeris": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "predictions_supported": {
      "const": false
    },
    "kind": {
      "const": "solar_terms_24"
    },
    "solar_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2099
    },
    "terms": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "name",
          "target_solar_longitude_deg",
          "utc",
          "local",
          "local_calendar_date",
          "numerical_root_check"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "target_solar_longitude_deg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "utc": {
            "type": "string"
          },
          "local": {
            "type": "string"
          },
          "numerical_root_check": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "astronomy",
    "solar_year",
    "terms"
  ]
}
